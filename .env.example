# ==============================================================================
# 1. DATABASE & POSTGRESQL (Docker Compose & Local Runtime)
# ==============================================================================
# PostgreSQL credentials used by docker-compose.yml for the database container
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="skd_chatbot"

# Full PostgreSQL Connection URL with pgvector support
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Host port 5434 maps to container port 5432 in docker-compose.yml
# Cloudflare Workers note: When deploying via OpenNext + Cloudflare Hyperdrive,
# bind Hyperdrive as `HYPERDRIVE` in wrangler.json; runtime resolution prioritizes
# `env.HYPERDRIVE.connectionString` over Worker `DATABASE_URL` secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/skd_chatbot"

# ==============================================================================
# 2. GOOGLE GEMINI AI & EMBEDDINGS
# ==============================================================================
# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"

# Primary & Fallback Generative Models (const model = GENERATIVE_MODEL || FALLBACK_GENERATIVE_MODEL)
GENERATIVE_MODEL="gemini-4-hydrogen"
FALLBACK_GENERATIVE_MODEL="gemini-3.5-flash-lite"

# Opt-in Google Search Grounding for explicit current-affairs queries (default: false)
ENABLE_GEMINI_GOOGLE_SEARCH="false"

# Embedding Model for Vector Search (768 dimensions, default: gemini-embedding-001)
EMBEDDING_MODEL="gemini-embedding-001"

# ==============================================================================
# 3. HYBRID SKD RAG (RETRIEVAL AUGMENTED GENERATION) CONFIGURATION
# ==============================================================================
# Minimum cosine similarity threshold for vector retrieval (0.0 to 1.0, default: 0.42)
RAG_SIMILARITY_THRESHOLD="0.42"

# Maximum number of knowledge context chunks returned per query
RAG_MAX_RESULTS="5"

# ==============================================================================
# 4. NEXTAUTH AUTHENTICATION & CRON SECURITY
# ==============================================================================
# Canonical URL for NextAuth callbacks and redirects
NEXTAUTH_URL="http://localhost:3000"

# Secret key for encrypting NextAuth session tokens (generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET="your-nextauth-secret"

# Bearer token protecting /api/cleanup-guest-chats DELETE cron endpoint
CRON_SECRET="your-cron-secret"

# ==============================================================================
# 5. DATABASE SEEDING (scripts/seed.ts)
# ==============================================================================
# Optional admin seed account (password required in production to seed admin)
SEED_ADMIN_USERNAME="admin_skd"
SEED_ADMIN_EMAIL="admin@skd-chatbot.local"
SEED_ADMIN_PASSWORD=""

# Optional demo user seed account (password required in production to seed demo)
SEED_DEMO_USERNAME="peserta_skd"
SEED_DEMO_EMAIL="peserta@skd-chatbot.local"
SEED_DEMO_PASSWORD=""

# ==============================================================================
# 6. RUNTIME & APPLICATION CONFIGURATION
# ==============================================================================
# Environment mode ("development" | "production" | "test")
NODE_ENV="development"
PORT="3000"

# Set to "true" to enable OpenNext Cloudflare dev bindings during `next dev`
ENABLE_CF_DEV="false"
