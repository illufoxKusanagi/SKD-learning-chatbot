# ==============================================================================
# 1. DATABASE & POSTGRESQL (Docker Compose & Local Runtime)
# ==============================================================================
# PostgreSQL credentials used by docker-compose.yml for the database container
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="skd_chatbot"

# Full PostgreSQL Connection URL with pgvector support
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Host port 5434 maps to container port 5432 in docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/skd_chatbot"

# ==============================================================================
# 2. GOOGLE GEMINI AI & EMBEDDINGS
# ==============================================================================
# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"

# Generative LLM Model for SKD Tutoring & Explanations (default: gemini-2.5-flash)
GENERATIVE_MODEL="gemini-2.5-flash"

# Embedding Model for Vector Search (768 dimensions, default: gemini-embedding-001)
EMBEDDING_MODEL="gemini-embedding-001"

# ==============================================================================
# 3. HYBRID SKD RAG (RETRIEVAL AUGMENTED GENERATION) CONFIGURATION
# ==============================================================================
# Minimum cosine similarity threshold for vector retrieval (0.0 to 1.0)
RAG_SIMILARITY_THRESHOLD="0.45"

# Maximum number of knowledge context chunks returned per query
RAG_MAX_RESULTS="5"

# ==============================================================================
# 4. NEXTAUTH & JWT AUTHENTICATION
# ==============================================================================
# Canonical URL for NextAuth callbacks and redirects
NEXTAUTH_URL="http://localhost:3000"

# Secret key for encrypting NextAuth session tokens (generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET="your-nextauth-secret"

# Secret key for signing custom JWT tokens (src/lib/auth/jwt.ts & middleware.ts)
JWT_SECRET="your-jwt-secret"

# JWT Token Expiration settings
JWT_EXPIRES_IN="7d"
ACCESS_TOKEN_EXPIRES_IN="3d"
REFRESH_TOKEN_EXPIRES_IN="15d"

# ==============================================================================
# 5. RUNTIME & APPLICATION CONFIGURATION
# ==============================================================================
# Environment mode ("development" | "production" | "test")
NODE_ENV="development"
PORT="3000"
